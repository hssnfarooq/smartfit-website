class ProductController extends Controller
{
    private $json_header, $sftp, $proizvod_folder, $naljepnica_folder;

    private $cijena_kemija_arr = [
        'BUDGET' => 22.50,
        'BUDGET WHOLESALE' => 22.50,
        'House Brand' => 22.50,

        'MID RANGE 2' => 27.50,
        'MID RANGE 3' => 27.50,
        'MID RANGE PREMIUM' => 27.50,

        'PREMIUM' => 32.50,
    ];

    public function index(Request $request){
      return Product::paginate();
    }

    public function show(Product $product){
        return $product;
    }


    //za dohvačanje slika
    private function sftpConnect(){

        $this->sftp = new SFTP(env('SFTP_HOST'), 2222);
        if (!$this->sftp->login(env('SFTP_USERNAME'), env('SFTP_PASSWORD')))
            throw new \Exception('Login failed');

    }

    private function checkPic($proizvod, $naljepnica){       

        $this->proizvod_folder = env('PROIZVOD_FOLDER');
        $this->naljepnica_folder = env('NALJEPNICA_FOLDER');

        //proizvod - /Images/TyrePatterns
        if($this->sftp->file_exists($this->proizvod_folder.$proizvod) && $this->sftp->is_dir($this->proizvod_folder)){ 

                $slika = $this->proizvod_folder.$proizvod;

                //da li postoji i dole
                if(!Storage::disk('public')->exists($slika)){

                    Storage::disk('public')->put($slika, $this->sftp->get($slika));

                }else{

                    //ako postoji, onda provjera jel noviji gornji file, ako nije onda ne treba niš
                    if(Storage::disk('public')->lastModified($slika) < $this->sftp->filemtime($slika)){
                        Storage::disk('public')->put($slika, $this->sftp->get($slika));
                    }

                }
    
        }
            
        //naljepnica - /Images/TyreLabels-EU2020-740
        if($this->sftp->file_exists($this->naljepnica_folder.$naljepnica) && $this->sftp->is_dir($this->naljepnica_folder)){

            $slika = $this->naljepnica_folder.$naljepnica;
            //da li postoji i dole
            if(!Storage::disk('public')->exists($slika)){

                Storage::disk('public')->put($slika, $this->sftp->get($slika));

            }else{

                //ako postoji, onda provjera jel noviji gornji file, ako nije onda ne treba niš
                if(Storage::disk('public')->lastModified($slika) < $this->sftp->filemtime($slika)){
                    Storage::disk('public')->put($slika, $this->sftp->get($slika));
                }

            }
  
        }

    }

    private function obrisiStaro(){

        /* $deleted = DB::table('lunar_prices')->where('csv_import', '=', 1)   //2194 je zadnja usluga sve poslje će biti gume     
             ->delete();
 
         //lunar_product_variants
         $deleted = DB::table('lunar_product_variants')->where('csv_import', '=', 1)   //2194 je zadnja usluga sve poslje će biti gume     
             ->delete();
         
         $deleted = DB::table('lunar_products')->where('csv_import', '=', 1)            
             ->where('t_import_json', 'IS', NULL)
             ->delete();
 
         $deleted = DB::table('lunar_urls')->where('element_id', '>', 2195)      //2194 je zadnja usluga sve poslje će biti gume           
             ->where('element_type', 'Lunar\Models\Product')
             ->delete();
 
 */
        DB::statement('SET FOREIGN_KEY_CHECKS=0;');

        DB::table('activity_log')->truncate();
        DB::table('lunar_channelables')->truncate();
        DB::table('search_index')->truncate();
        
        //prices
        DB::table('lunar_prices')->truncate();
        DB::statement("INSERT INTO lunar_prices SELECT * FROM lunar_prices_ORIG");

        //lunar_product_variants
        DB::table('lunar_product_variants')->truncate();
        DB::statement("INSERT INTO lunar_product_variants SELECT * FROM lunar_product_variants_ORIG");

        //lunar_urls
        DB::table('lunar_urls')->truncate();
        DB::statement("INSERT INTO lunar_urls SELECT * FROM lunar_urls_ORIG");

        //lunar_products
        DB::table('lunar_products')->truncate();
        DB::statement("INSERT INTO lunar_products SELECT * FROM lunar_products_ORIG");

        DB::statement('SET FOREIGN_KEY_CHECKS=1;');

         return true;
     }
 

    public function importCSV()//Request $request - kad i ako se bude uploadao kroz formu
    {
        
        $import = Import::where('gotov', 1)->whereDate('created_at', date('Y-m-d'))->first();
        if(!$import){
            //prvo sve obrisat
            if($this->obrisiStaro()){

                //spojit se na FTP server za slike - STAPLETONS
                if(env('IMPORT_PARTNER') === 'stapletons') 
                    $this->sftpConnect();

                //import
                $this->startImport();

            }else 
                die('Delete ERROR');

        }else{
            die('Imported '.$import->title);
        }
            
    }
    
    private function startImport()//Request $request - kad i ako se bude uploadao kroz formu
    {
        $import = Import::create([
            'title' => date("d-m-Y H:i:s"),
        ]);
        /*
        MOŽDA SE BUDE UPLOADAO JEDNOG DANA
        $request->validate([
            'import_csv' => 'required|mimes:csv',
        ]);
        //read csv file and skip data
        $file = $request->file('import_csv');
        $handle = fopen($file->path(), 'r');
*/
        $handle = fopen('import/'.env('IMPORT_PARTNER').'/'.env('IMPORT_FILE'), 'r');
        //echo 'import/'.env('IMPORT_PARTNER').'/'.env('IMPORT_FILE').'<br>';

        if ($handle !== FALSE) {
            $i = 0;
            while (($data = fgetcsv($handle)) !== FALSE) {
                $i++;
                $this->spremiProizvod($data, $i);

                //echo $i.'.) '.($data[0]).'<br>';
            }
        }

        fclose($handle);

        $import->gotov = true;
        $import->end_time =  date("d-m-Y H:i:s"); 
        $import->title .=  ' - '.date("d-m-Y H:i:s");

        $import->save();

        echo 'Products imported: '.$import->title;

        die();
    }

    private function spremiProizvod($data, $red){

        //provjera jel to prvi red di su imena kolona
        if($red == 1){
            $this->json_header = Arr::map($data, function (string $value) {
                $tmp = strtolower(str_replace(" ", "_", $value));
                $tmp = strtolower(str_replace(".", "", $tmp));
                $tmp = strtolower(str_replace("/", "_", $tmp));
                $tmp = strtolower(str_replace("&", "and", $tmp));
                return strtolower($tmp);
            });
        }else{
            
            $json_body = Arr::mapWithKeys($data, function (string $value, int $key) {
                return [$this->json_header[$key] => $value];
            });

          
            //brand
            $brand = Brand::firstOrCreate([
                'name' =>  $data[env('IMPORT_PARTNER') === 'stapletons' ? 1 : 19],//19 je edentyres // 1 je stapletons
            ]);

            $product = Product::updateOrCreate([
                'product_type_id' => 1,//hardkodano gume
                'status' => 'published',
                'brand_id' => $brand->id,
                't_import_json' => json_encode($json_body),
                'csv_import' => 1,
                'attribute_data' => [
                   // 'iiiii' => new Text($red),
                    'name' => new Text($data[env('IMPORT_PARTNER') === 'stapletons' ? 2 : 3]),
                    'description' => new Text(''),
                ],
            ]);
        
            $jedini = ProductVariant::create([
                'sku' => $data[0],
                'product_id' => $product->id,
                'tax_class_id' => 1,//hardkodano
                'csv_import' => 1,
                'shippable' => 0,
                /*'length_value' => 17,
                'length_unit' => 'in',
                'height_value' => 66,
                'height_unit' => 'mm',
                'width_value' => 175,
                'width_unit' => 'mm',*/
            ]);

            $tmp_cijena = $data[env('IMPORT_PARTNER') === 'stapletons' ? 14 : 5];
            //////////////////
            //KEMIJA ZA CIJENE -> Marža + fake pdv -> pdv 25% je privremeno na ruku dok se ne prebace na PDV (tad treba maknut)
            $marza = 0;
            $fake_pdv = 25;
            if(env('IMPORT_PARTNER') === 'edentyresales')
                if(isset($this->cijena_kemija_arr[$data[20]]))
                    $marza = $this->cijena_kemija_arr[$data[20]];                    
            $tmp_cijena += $marza;
            $tmp_cijena += ($fake_pdv/100) * $tmp_cijena;
            /////
    
            $jedini->prices()->create([
                'price' => ($tmp_cijena*100),//Price 13	Retail 14
                'currency_id' => 1,//funte u bazi
                'csv_import' => 1,
            ]);


            if(env('IMPORT_PARTNER') === 'stapletons'){
                $tmp_slika = strtoupper(str_replace(" ", "_", $data[25]));
                $tmp_naljepnica = strtoupper(str_replace(" ", "_", $data[26]));
                $this->checkPic($tmp_slika.'.png', $tmp_naljepnica);//proizvod, naljepnica
            }            
                
        }

    }

    ////////////////////////////////////////
    /// Priprema Statičnih proizvoda //////
    public function prepareStatic(){
        DB::statement('SET FOREIGN_KEY_CHECKS=0;');
        DB::table('lunar_prices_ORIG')->truncate();
        DB::table('lunar_product_variants_ORIG')->truncate();
        DB::table('lunar_urls_ORIG')->truncate();
        DB::table('lunar_products_ORIG')->truncate();
        DB::statement('SET FOREIGN_KEY_CHECKS=1;');

        //lunar_products
        $proizvodi = Product::where('csv_import', '=', 0)->get();
        $model = new Product();
        $columns_products = $this->withoutColumn(['id'], $model);
        
        $columns_product_variants = $this->withoutColumn(['id', 'product_id'], new ProductVariant());
        $columns_prices = $this->withoutColumn(['id', 'priceable_id'], new Price());//priceable_id <- product_variant
        $columns_urls = $this->withoutColumn(['id', 'element_id', 'default'], new Url());//element_id <- product_id

        $br = 0;
        foreach($proizvodi as $proizvod){
            $br++;
            $this->kopiraj('lunar_products', 'lunar_products_ORIG', $columns_products, ' WHERE id = '.$proizvod['id']);

            //lunar_product_variants
            $this->kopiraj(
                'lunar_product_variants', 
                'lunar_product_variants_ORIG', 
                $columns_product_variants, 
                ' WHERE product_id = '.$proizvod['id'],
                'product_id ,',
                $br.', '
            );

            //lunar_urls
            $this->kopiraj('lunar_urls', 
                'lunar_urls_ORIG', 
                $columns_urls, 
                ' WHERE element_id = '.$proizvod['id'],
                'element_id ,',
                $br.', '
            );
        }

        //PRICES su vezane uz VARIANT, pa to ide odvojeni loop
        $variants_old = ProductVariant::where('csv_import', '=', 0)->get();

        $variants = DB::table('lunar_product_variants_ORIG')->get();
        
        for($i=0;$i<count($variants);$i++)
            $this->kopiraj(
                'lunar_prices', 
                'lunar_prices_ORIG', 
                $columns_prices, 
                ' WHERE priceable_id = '.$variants_old[$i]->id,
                'priceable_id , ',
                $variants[$i]->id.', '
            );

        die('INITIAL VALUES ARE PREPARED..');
    }
       
    /**
     * Get all columns of model
     *
     * @return Array
     */
    private function getTableColumns($model) {
        //$model = new Product();
        return $model->getConnection()
            ->getSchemaBuilder()
            ->getColumnListing($model->getTable());
    }

    /**
     * Return model's columns without given columns
     *
     * @param Array $without_columns, $model
     * @return Array
     */
    private function withoutColumn(Array $without_columns, $model) {
        return array_diff($this->getTableColumns($model), $without_columns);
    }

    public function kopiraj($tbl_from, $tbl_to, $columns, $where, $dodatna_polja = '', $dodatne_vrijednosti = '') {
        
        $columns = implode(',', $columns);
        $tmp = DB::statement('INSERT INTO '.$tbl_to.' ('.$dodatna_polja.$columns.') (SELECT '.$dodatne_vrijednosti.$columns.' FROM '.$tbl_from.$where.')');

        //return Response::HTTP_OK;
    }
}